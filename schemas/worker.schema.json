{
  "$defs": {
    "Surface": {
      "enum": [
        "macos",
        "ios",
        "ipados",
        "visionos",
        "watchos",
        "tvos",
        "safari",
        "chromium",
        "firefox",
        "cli"
      ],
      "title": "Surface",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "worker_id": {
      "title": "Worker Id",
      "type": "string"

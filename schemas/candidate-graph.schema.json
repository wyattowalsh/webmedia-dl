{
  "$defs": {
    "FormatAlternative": {
      "additionalProperties": false,
      "properties": {
        "format_id": {
          "title": "Format Id",
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "vcodec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vcodec"
        },
        "acodec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acodec"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "bitrate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "drm": {
          "default": false,
          "title": "Drm",
          "type": "boolean"
        }
      },
      "required": [
        "format_id"
      ],
      "title": "FormatAlternative",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "from_id": {
          "format": "uuid",
          "title": "From Id",
          "type": "string"
        },
        "to_id": {
          "format": "uuid",
          "title": "To Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "alternative_of",
            "grouped_with",
            "derived_from",
            "conflicts_with"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "from_id",
        "to_id",
        "relation"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "MediaCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "identity_key": {
          "title": "Identity Key",
          "type": "string"
        },
        "title_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title Display"
        },
        "grouping_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grouping Key"
        },
        "retrieval_urls": {
          "items": {
            "type": "string"
          },
          "title": "Retrieval Urls",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/FormatAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "drm_signals": {
          "items": {
            "type": "string"
          },
          "title": "Drm Signals",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        }
      },
      "required": [
        "source_id",
        "media_kind",
        "identity_key"
      ],
      "title": "MediaCandidate",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video",
        "audio",
        "image",
        "gallery",
        "document",
        "subtitle",
        "live_stream",
        "page",
        "unknown"
      ],
      "title": "MediaKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "format": "uuid",
      "title": "Graph Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/MediaCandidate"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    }
  },
  "required": [
    "job_id"
  ],
  "title": "CandidateGraph",
  "type": "object",
  "$id": "https://webmedia-dl.local/schemas/candidate-graph.schema.json"
}
